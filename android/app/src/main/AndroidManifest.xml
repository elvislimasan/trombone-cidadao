<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="video/*" />
        </intent>
        <!-- Sem esta declaracao, no Android 11+ o resolveActivity do
             ADD_TO_STORY devolve null mesmo com o Instagram instalado. -->
        <package android:name="com.instagram.android" />
        <!-- Motor de sintese de voz (alertas falados do modo patrulha).
             As regras de visibilidade de pacote do Android 11+ escondem o
             servico de TTS: sem esta intent o TextToSpeech nao encontra
             nenhum engine e a patrulha volta a ficar muda. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme.NoActionBar">
        <activity
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- ✅ App Links (Deep Links) - Para abrir links no app -->
            <!-- URL scheme customizado: trombonecidadao://bronca/[ID] -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="trombonecidadao" android:host="bronca" />
            </intent-filter>

            <!-- ✅ Auth Callback - Para login social (Google, etc) -->
            <!-- Suporta tanto 'login-callback' quanto 'painel-usuario' para flexibilidade -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.trombonecidadao.app" android:host="login-callback" />
                <data android:scheme="com.trombonecidadao.app" android:host="painel-usuario" />
            </intent-filter>
            
            <!-- ✅ Android App Links (HTTPS) - Para links https://trombone-cidadao.vercel.app/bronca/[ID] -->
            <!-- IMPORTANTE: Requer arquivo .well-known/assetlinks.json no servidor -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data 
                    android:scheme="https"
                    android:host="trombone-cidadao.vercel.app"
                    android:pathPrefix="/bronca" />
            </intent-filter>
            
            <!-- ✅ Android App Links (HTTPS) - Produção -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data 
                    android:scheme="https"
                    android:host="trombonecidadao.com.br"
                    android:pathPrefix="/bronca" />
            </intent-filter>

            <!-- ✅ Android App Links (HTTPS) - Vercel (Dev/Fallback) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data 
                    android:scheme="https"
                    android:host="trombone-cidadao.vercel.app"
                    android:pathPrefix="/bronca" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Keep Alive Service (Para manter app vivo durante câmera) -->
        <service
            android:name=".KeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Upload Service (Processamento em Background) -->
        <service
            android:name=".UploadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Default notification channel -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="trombone_cidadao_notifications" />
        
        <!-- ✅ NOTIFICAÇÕES FIREBASE - Ícone e Cor Padrão -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@android:color/white" />
        
        <!-- ⚠️ IMPORTANTE: Configure a URL da sua política de privacidade antes de publicar na Play Store -->
        <!-- URL de Produção -->
        <meta-data
            android:name="privacy_policy_url"
            android:value="https://trombonecidadao.com.br/termos-de-uso" />
    </application>

    <!-- Permissions -->

    <!-- Permissões básicas -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Permissões de localização (necessário para geolocalização) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- Permissões de câmera e mídia (necessário para upload de fotos/vídeos) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Permissões de armazenamento (Android 12 e abaixo) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Android 13+ (API 33+): NÃO declarar READ_MEDIA_IMAGES / READ_MEDIA_VIDEO.
         A política do Google Play exige o uso do Photo Picker do sistema, que não
         requer permissão alguma. O app já usa apenas seletores de sistema:
           - Fotos : CapCamera.getPhoto(CameraSource.Photos) -> PickVisualMedia
           - Vídeos: VideoProcessorPlugin.pickVideo() -> MediaStore.ACTION_PICK_IMAGES
         `tools:node="remove"` garante que bibliotecas de terceiros não reintroduzam
         essas permissões via merge do manifesto. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    

    <!-- Foreground Service (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requer tipo específico -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
</manifest>
