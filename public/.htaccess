<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirect /share/abaixo-assinado/ID to Supabase Edge Function (petição)
  RewriteRule ^share/abaixo-assinado/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-petition?id=$1 [R=302,L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^abaixo-assinado/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-petition?id=$1 [R=302,L]

  # Redirect /share/bronca/ID to Supabase Edge Function (bronca)
  RewriteRule ^share/bronca/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-preview?id=$1 [R=302,L]

  # Redirect /bronca/ID to share-preview for bots (social media sharing)
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^bronca/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-preview?id=$1 [R=302,L]


  # Redirect /share/noticia/ID to Supabase Edge Function (noticia)
  RewriteRule ^share/noticia/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-news?id=$1 [R=302,L]

   RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^noticia/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-news?id=$1 [R=302,L]

  # Redirect /share/obra/ID to Supabase Edge Function (obra)
  RewriteRule ^share/obra/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-work?id=$1 [R=302,L]

   RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^obra/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-work?id=$1 [R=302,L]

  # Redirect /share/rua/SLUG to Supabase Edge Function (rua)
  RewriteRule ^share/rua/(.*)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-street?id=$1 [R=302,L]

  # Prévia do Guia da Cidade para itens, categorias e visão geral.
  RewriteRule ^share/guia/categoria/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-city-guide?type=category&id=$1 [R=302,L,QSA,NE]
  RewriteRule ^share/guia/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-city-guide?type=place&id=$1 [R=302,L,QSA,NE]
  RewriteRule ^share/guia/?$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-city-guide?type=index [R=302,L,QSA,NE]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^guia-da-cidade/categoria/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-city-guide?type=category&id=$1 [R=302,L,QSA,NE]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^guia-da-cidade/guia/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-city-guide?type=place&id=$1 [R=302,L,QSA,NE]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^guia-da-cidade/?$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-city-guide?type=index [R=302,L,QSA,NE]

  # Redirect /share/radar/ID to the social preview for city events
  RewriteRule ^share/radar/([^?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-city-event?id=$1 [R=302,L]

  # Redirect /share/perfil/USERNAME to the social preview with the profile photo
  RewriteRule ^share/perfil/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-public-profile?username=$1 [R=302,L,NE]

  # Serve the same preview when a social crawler receives the canonical profile URL
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^u/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-public-profile?username=$1 [R=302,L,NE]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^@([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-public-profile?username=$1 [R=302,L,NE]

  # A URL canônica do perfil agora é /username. Rotas do aplicativo ficam fora
  # desta regra e continuam usando suas próprias páginas/metatags.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^(?!(?:admin|sobre|estatisticas|feed|mapa|broncas|abaixo-assinados|obras-publicas|imoveis-alugados|agora|servicos|guiadacidade|guia-da-cidade|noticias|contato|perfil|configuracoes|explorar|seguindo|favoritos|salvos-outros|obras-favoritas|painel-usuario|alterar-senha|excluir-conta|minhas-peticoes|buscar|missoes|app|login|cadastro)/?$)([a-z0-9][a-z0-9._]{1,28}[a-z0-9])/?$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-public-profile?username=$1 [R=302,L,NE]

  # Prévia social rica das páginas legislativas.
  RewriteRule ^share/vereador/([^/?]+)/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-councilor?city=$1&slug=$2 [R=302,L,NE]

  # Se o endereço canônico for colado diretamente, os crawlers também recebem
  # o card 1200x630; visitantes continuam abrindo a página React normalmente.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Twitterbot|WhatsApp|TelegramBot|Discordbot|Slackbot|LinkedInBot|bingbot|Googlebot|Applebot|YandexBot|DuckDuckBot|Baiduspider|facebot) [NC]
  RewriteRule ^vereadores/([^/?]+)/([^/?]+)$ https://mrejgpcxaevooofyenzq.supabase.co/functions/v1/share-councilor?city=$1&slug=$2 [R=302,L,NE]


  
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # Cache everything on CDN by default
  Header set Cache-Control "public, s-maxage=604800, max-age=0"
  
  # Cache in browser all assets
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=604800"
  </If>
</IfModule>
